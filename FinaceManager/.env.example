# Single source of configuration: Django reads it via settings.py, and Docker Compose via
# `--env-file FinaceManager/.env` (install.ps1/install.sh generate it with random secrets).
# Copy to .env and edit. Never commit the real .env.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Add your LAN IP to open the app from other devices, e.g. localhost,127.0.0.1,192.168.1.20
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Database ---
DATABASE_NAME=financemanager
DATABASE_USER=financemanager
DATABASE_PASSWORD=change-me
DATABASE_ROOT_PASSWORD=change-me-too
# "db" is the Docker Compose service name of the MySQL container.
DATABASE_HOST=db
DATABASE_PORT=3306
DB_TIMEZONE=Asia/Kolkata

# --- Ports ---
# Port published on your machine: http://localhost:8000
HOST_PORT=8000
# Port gunicorn listens on inside the backend container.
APP_PORT=8000
WEB_CONCURRENCY=3

# --- Email (leave EMAIL_HOST empty to print password-reset emails to the backend logs) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
